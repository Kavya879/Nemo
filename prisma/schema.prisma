// ReLoop database schema — source of truth for all persisted data.
//
// Business rules (thresholds, radii, price bands, CO₂ factors, credit rates)
// live in the RoutingConfig table, NOT in code — that is what makes the
// "nothing hardcoded" principle real and lets behavior change live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Grade {
  A
  B
  C
  D
}

enum RoutingPath {
  RESELL_AS_IS
  REFURBISH
  PEER_TO_PEER
  DONATE
  RECYCLE
}

enum ItemStatus {
  RETURNED
  GRADED
  ROUTED
  LISTED
  SOLD
  DONATED
  RECYCLED
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  INACTIVE
}

enum GradedBy {
  bedrock
  local
  clip
}

enum OrderStatus {
  PLACED
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

/// The full lifecycle of a return decision case.
enum ReturnStatus {
  INITIATED
  GRADED
  FEASIBILITY_ANALYZED
  // Feasible path
  RETURN_APPROVED
  RETURN_PICKUP_SCHEDULED
  RETURNED_TO_SELLER
  // Not-feasible → Second Life path
  SECOND_LIFE_LISTED
  BUYER_RESERVED
  SL_PICKUP_SCHEDULED
  DELIVERY_VERIFICATION
  TRANSFER_APPROVED
  REFUND_INITIATED
  COMPLETED
  TRANSFER_REJECTED
  // No buyer within window
  WINDOW_EXPIRED
  LIQUIDATION_PICKUP
  LIQUIDATED
  // Donation classification requires the user's choice
  DONATION_PENDING
  DISCARDED
}

enum ReturnDecision {
  FEASIBLE
  NOT_FEASIBLE
}

enum Disposition {
  LIQUIDATED
  BULK_RESALE
  REFURBISHMENT
  RECYCLED
  DONATED
}

// ── Core models ─────────────────────────────────────────────────────────────

/// The physical product moving through the system.
model Item {
  id            String      @id @default(cuid())
  name          String
  category      String
  brand         String?
  originalPrice Float
  /// Reference product image (the "passport" baseline the return photo is compared to).
  imageUrl      String?
  currentGrade  Grade?
  status        ItemStatus  @default(RETURNED)
  /// Append-only ownership trail, e.g. [{ owner, from, to }].
  ownerHistory  Json        @default("[]")
  repairability Float       @default(0.5) // 0..1, how repairable this item is
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  returns          Return[]
  gradeResults     GradeResult[]
  routingDecisions RoutingDecision[]
  listing          Listing?
  greenCredits     GreenCredit[]
  orders           Order[]
  returnCases      ReturnCase[]

  @@index([category])
  @@index([status])
}

/// A return decision case — the persisted state machine + snapshots that drive
/// the full feasibility / second-life / liquidation workflow.
model ReturnCase {
  id     String @id @default(cuid())
  userId String @default("demo-user")
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  orderId String?
  reason  String
  status  ReturnStatus    @default(INITIATED)
  decision ReturnDecision?

  // Grading snapshot
  gradeResultId   String?
  grade           Grade?
  gradeConfidence Float?

  // Feasibility snapshot (the full cost/recovery breakdown as produced by the engine)
  feasibility Json?

  // Second Life
  secondLifeListingId String?
  secondLifeDeadline  DateTime?
  reservedBuyerId     String?
  reservedBuyerName   String?
  reservedDistanceKm  Float?

  // Delivery-partner verification
  verificationApproved Boolean?
  verificationNotes    String?
  rejectionReason      String?

  // Disposition / refund
  disposition       Disposition?
  refundInitiatedAt DateTime?
  refundAmount      Float?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  events    ReturnEvent[]

  @@index([userId])
  @@index([status])
  @@index([itemId])
}

/// Append-only audit trail of every state transition (traceability).
model ReturnEvent {
  id           String       @id @default(cuid())
  returnCaseId String
  returnCase   ReturnCase   @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)
  status       ReturnStatus
  message      String
  data         Json?
  createdAt    DateTime     @default(now())

  @@index([returnCaseId])
}

/// A customer's purchase of an item — what makes a return possible, and only
/// within the configured return window after delivery.
model Order {
  id         String      @id @default(cuid())
  userId     String      @default("demo-user")
  itemId     String
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderedAt  DateTime
  /// Null until delivered (newly-placed purchases aren't delivered yet).
  deliveredAt DateTime?
  status     OrderStatus @default(DELIVERED)
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([itemId])
}

/// A return event that brings an item back into the loop.
model Return {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reason    String
  /// Photo references (urls or data refs) captured at return time.
  photos    String[]
  createdAt DateTime @default(now())

  @@index([itemId])
}

/// The AI condition grade produced for an item.
model GradeResult {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  grade      Grade
  confidence Float
  /// [{ type, severity, location }]
  flaws      Json     @default("[]")
  summary    String
  gradedBy   GradedBy
  tookMs     Int
  createdAt  DateTime @default(now())

  @@index([itemId])
}

/// The chosen second-life path plus the reasoning + inputs that produced it.
model RoutingDecision {
  id        String      @id @default(cuid())
  itemId    String
  item      Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  path      RoutingPath
  reasoning String
  score     Float
  /// Snapshot of the inputs used (grade, costs, demand, …) for auditability.
  inputs    Json
  createdAt DateTime    @default(now())

  @@index([itemId])
}

/// A second-life listing in the marketplace.
model Listing {
  id          String        @id @default(cuid())
  itemId      String        @unique
  item        Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title       String
  description String
  price       Float
  /// Percentage of original price (for display/explanation).
  pricePct    Float
  photoUrl    String?
  status      ListingStatus @default(ACTIVE)
  /// Product Health Card: verified condition, history, warranty, flaws.
  healthCard  Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

/// A verified buyer with a location and a wishlist of wanted categories.
model Buyer {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  /// Categories the buyer wants (drives nearby matching).
  wishlist  String[]
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Green credits earned + CO₂ and cost saved for a second-life action.
model GreenCredit {
  id         String      @id @default(cuid())
  userId     String      @default("demo-user")
  itemId     String?
  item       Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  action     RoutingPath
  credits    Int
  co2SavedKg Float
  costSaved  Float
  createdAt  DateTime    @default(now())

  @@index([userId])
}

/// THE RULES TABLE. Single global row (id = "default"). Every business
/// threshold, rate, radius, band, and factor lives here so it can be changed
/// at runtime without touching code.
model RoutingConfig {
  id String @id @default("default")

  // ── Matching ──
  matchRadiusKm Float @default(5)

  // ── Routing thresholds ──
  /// Minimum nearby interested buyers for the peer-to-peer path to win.
  peerToPeerMinBuyers Int   @default(1)
  /// Repairability (0..1) at/above which REFURBISH is viable.
  repairabilityThreshold Float @default(0.5)
  /// Default route per grade, e.g. { "A": "RESELL_AS_IS", "D": "RECYCLE" }.
  gradeDefaultRoutes Json
  /// Grades considered "still working/usable" (eligible for donate/p2p).
  workingGrades Json @default("[\"A\",\"B\",\"C\"]")

  // ── Pricing ──
  /// Price bands as % of original per grade: { "A": { "min": 0.8, "max": 0.9 }, … }.
  priceBands Json
  /// Multiplier applied when local demand is high (scarcity premium).
  demandPriceMultiplier Float @default(1.05)

  // ── Credits & impact ──
  /// Credits awarded per path, e.g. { "PEER_TO_PEER": 50, "RECYCLE": 10 }.
  creditsPerAction Json
  /// kg CO₂ saved per category for a second-life action.
  co2FactorsByCategory Json
  /// Default kg CO₂ saved when category not in the map above.
  co2DefaultKg Float @default(2.5)
  /// Fraction of original price treated as cost saved by reuse.
  costSavedFactor Float @default(0.6)

  // ── Prevention ──
  /// Base confidence for prevention guidance (0..1).
  preventionBaseConfidence Float @default(0.7)

  // ── Returns ──
  /// Days after delivery during which an order is still returnable.
  returnWindowDays Int @default(30)

  // ── Reverse-logistics cost model (Feasibility Analysis Engine) ──
  /// Fixed cost to dispatch a pickup agent.
  pickupBaseCost Float @default(80)
  /// Per-km line-haul cost for moving the item back to the warehouse/seller.
  transportCostPerKm Float @default(3)
  /// Inbound warehouse handling (dock, scan, putaway).
  warehouseHandlingCost Float @default(40)
  /// Manual inspection / re-grade at the warehouse.
  inspectionCost Float @default(35)
  /// Base repackaging cost (scaled up for lower grades).
  repackagingBaseCost Float @default(25)
  /// Storage cost per day while the item awaits disposition.
  storageCostPerDay Float @default(8)
  /// Expected number of days the item sits in storage.
  estimatedStorageDays Int @default(10)
  /// Seller / return warehouse coordinates (transport distance is measured to here).
  warehouseLat Float @default(11.0168)
  warehouseLng Float @default(76.9558)
  /// Intrinsic current-value fraction of original price, per grade.
  /// Optional only so the column can be added to an existing row; the seed
  /// always populates it and the engine reads it from config.
  depreciationByGrade Json?
  /// Minimum acceptable net recovery (₹) for a return to be feasible.
  minNetRecoveryValue Float @default(0)
  /// Minimum resale-value-to-cost ratio for a return to be feasible.
  feasibilityRatio Float @default(1.15)
  /// Length of the Second Life opportunity window (days).
  secondLifeWindowDays Int @default(7)

  updatedAt DateTime @updatedAt
}

/// A redemption of green credits for a reward (negative side of the ledger).
model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String   @default("demo-user")
  rewardId    String
  rewardLabel String
  cost        Int
  /// Unique coupon code issued at redemption (shown in Redeemed Coupons).
  code        String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId])
}
