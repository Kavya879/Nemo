// Amazon Nemo database schema — source of truth for all persisted data.
//
// Business rules (thresholds, radii, price bands, CO₂ factors, credit rates)
// live in the RoutingConfig table, NOT in code — that is what makes the
// "nothing hardcoded" principle real and lets behavior change live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Grade {
  A
  B
  C
  D
}

enum RoutingPath {
  RESELL_AS_IS
  REFURBISH
  PEER_TO_PEER
  DONATE
  RECYCLE
}

enum ItemStatus {
  RETURNED
  GRADED
  ROUTED
  LISTED
  SOLD
  DONATED
  RECYCLED
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  INACTIVE
}

enum GradedBy {
  bedrock
  local
  clip
}

enum OrderStatus {
  PLACED
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

/// The full lifecycle of a return decision case.
enum ReturnStatus {
  INITIATED
  // Pre-grade product-verification gate
  VERIFYING
  EVIDENCE_REQUESTED
  MANUAL_REVIEW
  GRADED
  FEASIBILITY_ANALYZED
  // Feasible path
  RETURN_APPROVED
  RETURN_PICKUP_SCHEDULED
  RETURNED_TO_SELLER
  // Not-feasible → Second Life path
  SECOND_LIFE_LISTED
  BUYER_RESERVED
  SL_PICKUP_SCHEDULED
  DELIVERY_VERIFICATION
  TRANSFER_APPROVED
  REFUND_INITIATED
  COMPLETED
  TRANSFER_REJECTED
  // No buyer within window
  WINDOW_EXPIRED
  LIQUIDATION_PICKUP
  LIQUIDATED
  // Donation classification requires the user's choice
  DONATION_PENDING
  DISCARDED
}

enum ReturnDecision {
  FEASIBLE
  NOT_FEASIBLE
}

enum Disposition {
  LIQUIDATED
  BULK_RESALE
  REFURBISHMENT
  RECYCLED
  DONATED
}

/// Outcome of the pre-grade product-verification gate.
enum VerificationRecommendation {
  /// Identity confirmed + low fraud risk → safe to grade.
  PROCEED
  /// Match/quality too low → ask the seller for more/better photos.
  REQUEST_EVIDENCE
  /// Fraud signals or strong deviation → escalate to a human reviewer.
  MANUAL_REVIEW
}

/// Lifecycle of an AI-verdict challenge (seller dispute → ops review).
enum ChallengeStatus {
  OPEN
  UNDER_REVIEW
  NEEDS_MORE_INFO
  RESOLVED_UPHELD
  RESOLVED_MODIFIED
  RESOLVED_OVERRIDDEN
  REJECTED
}

/// The reviewer's decision on a challenge.
enum ChallengeResolution {
  /// AI verdict was correct — keep it.
  UPHOLD
  /// Adjust the grade (a tweak the evidence supports).
  MODIFY
  /// Replace the AI verdict entirely with the reviewer's grade.
  OVERRIDE
  /// Dispute rejected — AI verdict stands, no further action.
  REJECT
}

// ── Core models ─────────────────────────────────────────────────────────────

/// The physical product moving through the system.
model Item {
  id            String      @id @default(cuid())
  name          String
  category      String
  brand         String?
  originalPrice Float
  /// Reference product image (the "passport" baseline the return photo is compared to).
  imageUrl      String?
  currentGrade  Grade?
  status        ItemStatus  @default(RETURNED)
  /// Append-only ownership trail, e.g. [{ owner, from, to }].
  ownerHistory  Json        @default("[]")
  repairability Float       @default(0.5) // 0..1, how repairable this item is
  /// Optional structured attributes (dimensions, weight, compatibility, etc.).
  /// Drives the Product Passport + (later) the compatibility checker; empty-safe.
  specs         Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  returns             Return[]
  gradeResults        GradeResult[]
  routingDecisions    RoutingDecision[]
  listing             Listing?
  greenCredits        GreenCredit[]
  orders              Order[]
  returnCases         ReturnCase[]
  verificationResults VerificationResult[]
  reviews             Review[]
  productViews        ProductView[]
  wishlistItems       WishlistItem[]
  challenges          Challenge[]

  @@index([category])
  @@index([status])
}

/// A customer product review — real text + a cached sentiment score (computed
/// once at write time via the open-source sentiment model). Powers the
/// satisfaction / return-risk signals and review summaries.
model Review {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String   @default("demo-user")
  authorName String?
  rating    Int      // 1..5 stars
  title     String?
  body      String
  /// Cached sentiment in -1..1 (negative..positive); null until scored.
  sentiment Float?
  createdAt DateTime @default(now())

  @@index([itemId])
}

/// A browsing event — the shopper viewed a product. Feeds browsing-history and
/// "customers like you" cohort signals.
model ProductView {
  id        String   @id @default(cuid())
  userId    String   @default("demo-user")
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  listingId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}

/// A product a shopper saved — per-product wishlist (distinct from the Buyer
/// category wishlist used for second-life matching).
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @default("demo-user")
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

/// A return decision case — the persisted state machine + snapshots that drive
/// the full feasibility / second-life / liquidation workflow.
model ReturnCase {
  id     String @id @default(cuid())
  userId String @default("demo-user")
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  orderId String?
  reason  String
  status  ReturnStatus    @default(INITIATED)
  decision ReturnDecision?

  // Pickup location (customer/return origin) — drives warehouse-proximity
  // routing and nearby-buyer matching. Falls back to the demo center if unset.
  pickupLat Float?
  pickupLng Float?

  // Photos the customer submitted at return time, persisted so the admin and the
  // pickup delivery partner can view them and compare against the original item.
  // [{ data: base64, mimeType, role }]
  returnPhotos Json @default("[]")

  // Pre-grade verification snapshot
  verificationResultId   String?
  productMatchConfidence Float?
  fraudRiskScore         Float?
  /// How many times the pre-grade verification gate has failed (drives the
  /// "request admin verification" escalation after repeated failures).
  verificationAttempts   Int     @default(0)

  // Grading snapshot
  gradeResultId   String?
  grade           Grade?
  gradeConfidence Float?

  // Feasibility snapshot (the full cost/recovery breakdown as produced by the engine)
  feasibility Json?

  // Second Life
  secondLifeListingId String?
  secondLifeDeadline  DateTime?
  reservedBuyerId     String?
  reservedBuyerName   String?
  reservedDistanceKm  Float?

  // Return-in-Transit early sale — the item is offered to nearby buyers at a
  // dynamically-growing discount while still in the return pipeline, instead of
  // waiting for warehouse intake/grading. Set once a buyer purchases it.
  transitSold       Boolean   @default(false)
  transitBuyerId    String?
  transitBuyerName  String?
  transitReservedAt DateTime?

  // Delivery-partner verification
  verificationApproved Boolean?
  verificationNotes    String?
  rejectionReason      String?

  // Disposition / refund
  disposition       Disposition?
  refundInitiatedAt DateTime?
  refundAmount      Float?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  events    ReturnEvent[]
  challenges Challenge[]

  @@index([userId])
  @@index([status])
  @@index([itemId])
}

/// Append-only audit trail of every state transition (traceability).
model ReturnEvent {
  id           String       @id @default(cuid())
  returnCaseId String
  returnCase   ReturnCase   @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)
  status       ReturnStatus
  message      String
  data         Json?
  createdAt    DateTime     @default(now())

  @@index([returnCaseId])
}

/// A customer's purchase — of either a second-life Item (resold) or a brand-new
/// Product. Resold purchases are returnable within the configured window;
/// brand-new product purchases carry a quantity and decrement Product stock.
model Order {
  id         String      @id @default(cuid())
  userId     String      @default("demo-user")
  /// Set for resold purchases (links to the physical Item that can be returned).
  itemId     String?
  item       Item?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Set for brand-new purchases (links to the catalog Product).
  productId  String?
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Units purchased (always 1 for resold; 1..N for brand-new).
  quantity   Int         @default(1)
  /// Unit price captured at purchase time (for brand-new line totals).
  unitPrice  Float?
  orderedAt  DateTime
  /// Null until delivered (newly-placed purchases aren't delivered yet).
  deliveredAt DateTime?
  status     OrderStatus @default(DELIVERED)
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([itemId])
  @@index([productId])
}

/// A brand-new catalog product — standard Amazon-style inventory with multiple
/// units in stock. Distinct from the Item→Listing second-life (resold) flow.
model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  brand       String?
  description String
  price       Float
  imageUrl    String?
  /// Available units. Out of stock when this reaches 0.
  stock       Int      @default(0)
  /// Cumulative units sold (for display / analytics).
  soldCount   Int      @default(0)
  /// Whether the product is listed for sale at all.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([category])
  @@index([active])
}

/// A return event that brings an item back into the loop.
model Return {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reason    String
  /// Photo references (urls or data refs) captured at return time.
  photos    String[]
  createdAt DateTime @default(now())

  @@index([itemId])
}

/// The AI condition grade produced for an item.
model GradeResult {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  grade      Grade
  /// Quality Assessment Confidence (0..1) — how sure the grader is of the grade.
  confidence Float
  /// [{ type, severity, location }]
  flaws      Json     @default("[]")
  summary    String
  gradedBy   GradedBy
  tookMs     Int
  /// Carried over from the verification gate so the full assessment lives together.
  productMatchConfidence Float?
  fraudRiskScore         Float?
  createdAt  DateTime @default(now())

  @@index([itemId])
}

/// The pre-grade product-verification assessment: does the uploaded item match
/// the originally purchased product? Produced BEFORE any grade is assigned.
model VerificationResult {
  id           String      @id @default(cuid())
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  returnCaseId String?
  /// Product Match Confidence (0..1).
  productMatchConfidence Float
  /// Fraud Risk Score (0..1) — higher means more likely a swap/counterfeit/wrong item.
  fraudRiskScore         Float
  /// Per-dimension match: { category, brand, model, packaging, visual } each 0..1.
  attributes   Json
  /// [{ attribute, detail, severity }] — observed mismatches.
  deviations   Json        @default("[]")
  recommendation VerificationRecommendation
  verifiedBy   GradedBy
  /// Roles of the images supplied, e.g. ["front","back","packaging"].
  imageRoles   String[]    @default([])
  summary      String
  tookMs       Int
  createdAt    DateTime    @default(now())

  @@index([itemId])
  @@index([returnCaseId])
}

/// A formal challenge/escalation of an AI verdict — the review ticket itself.
/// Covers grade disputes (tied to a return case) AND pre-grade verification
/// escalations from either the return flow or the Sell flow (which has no
/// return case — only an item). `kind` distinguishes them.
model Challenge {
  id             String          @id @default(cuid())
  /// Set for return-flow challenges; null for Sell-flow verification escalations.
  returnCaseId   String?
  returnCase     ReturnCase?     @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)
  itemId         String
  /// Always-present item link so any challenge can be reviewed standalone.
  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// "GRADE_DISPUTE" | "RETURN_VERIFICATION" | "SELL_VERIFICATION".
  kind           String          @default("GRADE_DISPUTE")
  openedByUserId String
  openedByName   String?
  status         ChallengeStatus @default(OPEN)
  /// Short reason category, e.g. "Grade too low".
  reason         String
  /// The seller's free-text explanation.
  sellerComment  String
  /// Immutable snapshot of the AI assessment at dispute time
  /// (grade, confidence, fraud risk, product match, verification, flaws).
  snapshot       Json
  /// Reviewer / team the ticket is routed to.
  assignedTo     String?
  resolution     ChallengeResolution?
  /// The grade the reviewer set (on MODIFY/OVERRIDE).
  revisedGrade   Grade?
  resolutionReasoning String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  evidence ChallengeEvidence[]
  events   ChallengeEvent[]

  @@index([returnCaseId])
  @@index([status])
  @@index([openedByUserId])
}

/// Supporting evidence a seller (or reviewer) attaches to a challenge.
model ChallengeEvidence {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  /// base64 data string or URL.
  data        String
  mimeType    String    @default("image/jpeg")
  role        String    @default("other")
  note        String?
  /// Who attached it: the seller or a reviewer.
  addedBy     String    @default("seller")
  createdAt   DateTime  @default(now())

  @@index([challengeId])
}

/// Append-only audit trail of every challenge state change (transparency).
model ChallengeEvent {
  id          String          @id @default(cuid())
  challengeId String
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  status      ChallengeStatus
  message     String
  /// Who acted: "seller", a reviewer name, or "system".
  actor       String          @default("system")
  data        Json?
  createdAt   DateTime        @default(now())

  @@index([challengeId])
}

/// The chosen second-life path plus the reasoning + inputs that produced it.
model RoutingDecision {
  id        String      @id @default(cuid())
  itemId    String
  item      Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  path      RoutingPath
  reasoning String
  score     Float
  /// Snapshot of the inputs used (grade, costs, demand, …) for auditability.
  inputs    Json
  createdAt DateTime    @default(now())

  @@index([itemId])
}

/// A second-life listing in the marketplace.
model Listing {
  id          String        @id @default(cuid())
  itemId      String        @unique
  item        Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title       String
  description String
  price       Float
  /// Percentage of original price (for display/explanation).
  pricePct    Float
  photoUrl    String?
  status      ListingStatus @default(ACTIVE)
  /// Product Health Card: verified condition, history, warranty, flaws.
  healthCard  Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

/// A verified buyer with a location and a wishlist of wanted categories.
model Buyer {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  /// Categories the buyer wants (drives nearby matching).
  wishlist  String[]
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Green credits earned + CO₂ and cost saved for a second-life action.
model GreenCredit {
  id         String      @id @default(cuid())
  userId     String      @default("demo-user")
  itemId     String?
  item       Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  action     RoutingPath
  credits    Int
  co2SavedKg Float
  costSaved  Float
  createdAt  DateTime    @default(now())

  @@index([userId])
}

/// THE RULES TABLE. Single global row (id = "default"). Every business
/// threshold, rate, radius, band, and factor lives here so it can be changed
/// at runtime without touching code.
model RoutingConfig {
  id String @id @default("default")

  // ── Matching ──
  matchRadiusKm Float @default(5)

  // ── Pre-grade verification thresholds ──
  /// Minimum Product Match Confidence (0..1) required to proceed to grading.
  verificationMatchThreshold Float @default(0.7)
  /// Fraud Risk Score (0..1) at/above which a case is escalated to manual review.
  fraudRiskThreshold Float @default(0.5)
  /// Minimum Quality Assessment Confidence (0..1) for a grade to be auto-assigned.
  minQualityConfidence Float @default(0.6)

  // ── Routing thresholds ──
  /// Minimum nearby interested buyers for the peer-to-peer path to win.
  peerToPeerMinBuyers Int   @default(1)
  /// Repairability (0..1) at/above which REFURBISH is viable.
  repairabilityThreshold Float @default(0.5)
  /// Default route per grade, e.g. { "A": "RESELL_AS_IS", "D": "RECYCLE" }.
  gradeDefaultRoutes Json
  /// Grades considered "still working/usable" (eligible for donate/p2p).
  workingGrades Json @default("[\"A\",\"B\",\"C\"]")

  // ── Pricing ──
  /// Price bands as % of original per grade: { "A": { "min": 0.8, "max": 0.9 }, … }.
  priceBands Json
  /// Multiplier applied when local demand is high (scarcity premium).
  demandPriceMultiplier Float @default(1.05)

  // ── Credits & impact ──
  /// Credits awarded per path, e.g. { "PEER_TO_PEER": 50, "RECYCLE": 10 }.
  creditsPerAction Json
  /// kg CO₂ saved per category for a second-life action.
  co2FactorsByCategory Json
  /// Default kg CO₂ saved when category not in the map above.
  co2DefaultKg Float @default(2.5)
  /// Fraction of original price treated as cost saved by reuse.
  costSavedFactor Float @default(0.6)

  // ── Prevention ──
  /// Base confidence for prevention guidance (0..1).
  preventionBaseConfidence Float @default(0.7)

  // ── Returns ──
  /// Days after delivery during which an order is still returnable.
  returnWindowDays Int @default(30)

  // ── Reverse-logistics cost model (Feasibility Analysis Engine) ──
  /// Fixed cost to dispatch a pickup agent.
  pickupBaseCost Float @default(80)
  /// Per-km line-haul cost for moving the item back to the warehouse/seller.
  transportCostPerKm Float @default(3)
  /// Inbound warehouse handling (dock, scan, putaway).
  warehouseHandlingCost Float @default(40)
  /// Manual inspection / re-grade at the warehouse.
  inspectionCost Float @default(35)
  /// Base repackaging cost (scaled up for lower grades).
  repackagingBaseCost Float @default(25)
  /// Storage cost per day while the item awaits disposition.
  storageCostPerDay Float @default(8)
  /// Expected number of days the item sits in storage.
  estimatedStorageDays Int @default(10)
  /// Seller / return warehouse coordinates (transport distance is measured to here).
  warehouseLat Float @default(11.0168)
  warehouseLng Float @default(76.9558)
  /// Intrinsic current-value fraction of original price, per grade.
  /// Optional only so the column can be added to an existing row; the seed
  /// always populates it and the engine reads it from config.
  depreciationByGrade Json?
  /// Minimum acceptable net recovery (₹) for a return to be feasible.
  minNetRecoveryValue Float @default(0)
  /// Minimum resale-value-to-cost ratio for a return to be feasible.
  feasibilityRatio Float @default(1.15)
  /// If the pickup is within this many km of a fulfillment center, return it
  /// normally (don't list for resale); beyond it, list for nearby buyers.
  warehouseProximityKm Float @default(50)
  /// Length of the Second Life opportunity window (days).
  secondLifeWindowDays Int @default(7)

  // ── Return-in-Transit early-sale rules ──
  /// Estimated days from return initiation until the item would arrive — used to
  /// show buyers an estimated arrival date for in-transit deals.
  returnTransitArrivalDays Int @default(7)
  /// Discount tiers as days-in-pipeline → fraction off, e.g.
  /// [{ "minDays": 0, "pct": 0 }, { "minDays": 4, "pct": 0.05 }, { "minDays": 6, "pct": 0.10 }].
  /// The highest tier whose minDays ≤ elapsed days applies. Nullable so it can be
  /// added to an existing row; the seed always populates it.
  returnTransitDiscountTiers Json?

  updatedAt DateTime @updatedAt
}

/// A redemption of green credits for a reward (negative side of the ledger).
model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String   @default("demo-user")
  rewardId    String
  rewardLabel String
  cost        Int
  /// Unique coupon code issued at redemption (shown in Redeemed Coupons).
  code        String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId])
}
