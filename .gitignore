# dependencies
/node_modules
/.pnp
.pnp.js

# lock file — excluded so deploy platforms use `npm install` (cross-platform
# tolerant) instead of `npm ci`, which fails when the Windows-generated lock
# is missing Linux-only optional native deps (@emnapi, @img/sharp-linux-*).
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit real secrets
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db
/prisma/*.db-journal

# transformers.js model cache
/.cache
/models/*
# …but DO commit the trained kaputt grader model (4MB) so AI grading works on deploy
!/models/mobilenet_kaputt.onnx
