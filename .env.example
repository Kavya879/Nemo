# ─────────────────────────────────────────────────────────────
# ReLoop environment variables
# Copy this file to `.env` and fill in real values.
# The app validates every variable at startup (src/config/env.ts)
# and refuses to boot if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────

# Runtime ----------------------------------------------------------------
NODE_ENV=development

# Database (Neon Postgres) -----------------------------------------------
# Create a free project at https://neon.tech and copy the connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Redis (Upstash, REST API) ----------------------------------------------
# Create a free DB at https://upstash.com → "REST API" tab.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# AI grading provider ----------------------------------------------------
# Which grader to use as the primary implementation: "bedrock" | "local"
# (the service always falls back to "local" if the primary fails).
GRADER_PROVIDER="bedrock"

# AWS Bedrock (primary grader) -------------------------------------------
# IAM user with Bedrock access + model access granted in the Bedrock console.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# Vision-capable Bedrock model id (Claude). Override per region/model as needed.
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"
# Model used for listing title/description generation (can be cheaper/faster).
BEDROCK_TEXT_MODEL_ID="anthropic.claude-3-5-haiku-20241022-v1:0"

# Local grader (offline fallback, Transformers.js) -----------------------
# Image-classification model pulled from the HF hub on first use. No key needed.
LOCAL_GRADER_MODEL="Xenova/vit-base-patch16-224"

# App ---------------------------------------------------------------------
# Public base URL of the API the frontend talks to.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
