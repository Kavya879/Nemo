# PostgreSQL connection (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reloop?schema=public"

# App name
NEXT_PUBLIC_APP_NAME="ReLoop"

# AI Service (optional — app works without it)
AI_SERVICE_URL="http://localhost:8000"

# Ollama local LLM (optional — app has deterministic fallbacks)
# Install: https://ollama.com/download
# Pull a model: ollama pull llama3.2
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# YOLO model path (optional — leave empty for placeholder)
YOLO_MODEL_PATH=""
